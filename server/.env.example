# Copy this file to .env to change settings
PORT=5000
# true  = any ID/password signs in as the demo student (same as the original project)
# false = only real students from the database can sign in
DEMO_MODE=true
# Optional: custom location of the SQLite file
# DB_FILE=./data/campus_portal.db

# Deployed frontend URL (your Netlify site) - optional but recommended on Render
# CLIENT_ORIGIN=https://your-site.netlify.app
